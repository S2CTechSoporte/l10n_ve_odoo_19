<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quotation_tree_with_zone" model="ir.ui.view">
        <field name="name">sale.order.list.quotation.zone</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="sale_order_list_upload_with_zone" model="ir.ui.view">
        <field name="name">sale.order.list.upload.zone</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_list_upload"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="state_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="sale_order_quotation_search_with_zone" model="ir.ui.view">
        <field name="name">sale.order.search.quotation.zone</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="state_id"/>
            </field>
            <filter name="salesperson" position="after">
                <filter name="zone" string="Zone" context="{'group_by': 'state_id'}"/>
            </filter>
        </field>
    </record>

    <record id="sale_order_search_with_zone" model="ir.ui.view">
        <field name="name">sale.order.search.order.zone</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="state_id"/>
            </field>
            <filter name="salesperson" position="after">
                <filter name="zone" string="Zone" context="{'group_by': 'state_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_order_form_with_zone" model="ir.ui.view">
        <field name="name">sale.order.form.zone</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']/field[@name='user_id']" position="after">
                <field name="state_id"/>
            </xpath>
        </field>
    </record>
</odoo>