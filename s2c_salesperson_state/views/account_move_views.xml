<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_with_zone" model="ir.ui.view">
        <field name="name">account.out.invoice.list.zone</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="state_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_with_zone" model="ir.ui.view">
        <field name="name">account.invoice.search.zone</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="state_id"/>
            </field>
            <filter name="salesperson" position="after">
                <filter name="zone" string="Zone" context="{'group_by': 'state_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_move_form_with_zone" model="ir.ui.view">
        <field name="name">account.move.form.zone</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="after">
                <field name="state_id"/>
            </xpath>
        </field>
    </record>
</odoo>