        <function model="res.users" name="write">
            <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
            <value eval="{'company_ids': [(4, ref('l10n_ve_full.company_my_company_ves')), (4, ref('l10n_ve_full.company_my_company_usd'))]}"/>
        </function>

        <function model="account.chart.template" name="try_loading">
            <value eval="[]"/>
            <value>ve</value>
            <value model="res.company" eval="obj().env.ref('l10n_ve_full.company_my_company_ves')"/>
            <value name="install_demo" eval="False"/>
        </function>

        <function model="account.chart.template" name="try_loading">
            <value eval="[]"/>
            <value>ve</value>
            <value model="res.company" eval="obj().env.ref('l10n_ve_full.company_my_company_usd')"/>
            <value name="install_demo" eval="False"/>
        </function>

        <function model="res.company" name="write">
            <value eval="[ref('l10n_ve_full.company_my_company_ves')]"/>
