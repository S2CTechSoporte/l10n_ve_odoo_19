<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_dual_currency" model="ir.ui.view">
        <field name="name">account.move.form.dual.currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="secondary_currency_id" readonly="1"/>
                <field name="conversion_rate_display_currency_id" invisible="1"/>
                <field name="conversion_rate_display_is_usd" invisible="1"/>
                <field name="conversion_rate_display" readonly="1" widget="monetary"
                    invisible="not conversion_rate_display_is_usd"
                    options="{'currency_field': 'conversion_rate_display_currency_id'}"/>
                <field name="conversion_rate_display" string="Reference Rate" readonly="1" widget="monetary"
                    invisible="conversion_rate_display_is_usd"
                    options="{'currency_field': 'conversion_rate_display_currency_id'}"/>
                <!-- Manual rate: visible to accounting administrators on vendor documents only.
                     The helper fields have no group so that the modifiers of every user can read
                     them; the controls below disappear for users without the group. -->
                <field name="manual_rate_available" invisible="1"/>
                <field name="manual_rate_active" invisible="1"/>
                <field name="manual_rate_is_usd" invisible="1"/>
                <field name="manual_rate"
                    groups="account.group_account_manager"
                    invisible="not manual_rate_available or move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                    readonly="state != 'draft'"/>
                <label for="manual_conversion_rate" string="Manual USD Rate"
                    groups="account.group_account_manager"
                    invisible="not manual_rate or not manual_rate_available or not manual_rate_is_usd or move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
                <label for="manual_conversion_rate" string="Manual Reference Rate"
                    groups="account.group_account_manager"
                    invisible="not manual_rate or not manual_rate_available or manual_rate_is_usd or move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
                <div class="o_row" name="manual_conversion_rate_div"
                    groups="account.group_account_manager"
                    invisible="not manual_rate or not manual_rate_available or move_type not in ('in_invoice', 'in_refund', 'in_receipt')">
                    <field name="manual_conversion_rate" digits="[12, 6]"
                        required="manual_rate"
                        readonly="state != 'draft'"/>
                    <field name="manual_rate_currency_id" readonly="1" options="{'no_open': True}"/>
                </div>
                <field name="same_currency" invisible="1"/>
            </xpath>

            <!-- With the manual rate in use the native rate follows it, so it is not editable. -->
            <xpath expr="//field[@name='invoice_currency_rate']" position="attributes">
                <attribute name="readonly">state != 'draft' or manual_rate_active</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="secondary_currency_id" column_invisible="True"/>
                <field
                    name="price_unit_secondary_currency"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'secondary_currency_id'}"
                />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="before">
                <field
                    name="price_subtotal_secondary_currency"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'secondary_currency_id'}"
                />
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='credit']" position="after">
                <field name="secondary_currency_id" column_invisible="True"/>
                <field
                    name="conversion_rate"
                    string="Reference Rate"
                    optional="hide"
                    invisible="display_type in ('line_section', 'line_subsection', 'line_note')"
                />
                <field
                    name="debit_secondary_currency"
                    optional="hide"
                    sum="Total Reference Debit"
                    invisible="display_type in ('line_section', 'line_subsection', 'line_note')"
                />
                <field
                    name="credit_secondary_currency"
                    optional="hide"
                    sum="Total Reference Credit"
                    invisible="display_type in ('line_section', 'line_subsection', 'line_note')"
                />
                <field name="balance_secondary_currency" column_invisible="True"/>
                <field name="amount_residual_secondary_currency" optional="hide" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='tax_totals']/.." position="before">
                <group
                    class="oe_subtotal_footer"
                    invisible="not same_currency or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"
                >
                    <field name="amount_untaxed_secondary_currency"/>
                    <field name="amount_tax_secondary_currency"/>
                    <field name="amount_total_secondary_currency" class="oe_subtotal_footer_separator"/>
                    <field
                        name="invoice_payments_widget_secondary_currency"
                        colspan="2"
                        nolabel="1"
                        widget="payment"
                        invisible="not invoice_payments_widget_secondary_currency"
                    />
                    <field
                        name="amount_residual_secondary_currency"
                        class="oe_subtotal_footer_separator"
                        invisible="state == 'draft'"
                    />
                </group>
                <group
                    class="oe_subtotal_footer"
                    invisible="same_currency or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"
                >
                    <field name="amount_untaxed_local_currency"/>
                    <field name="amount_tax_local_currency"/>
                    <field name="amount_total_local_currency" class="oe_subtotal_footer_separator"/>
                    <field
                        name="invoice_payments_widget_local_currency"
                        colspan="2"
                        nolabel="1"
                        widget="payment"
                        invisible="not invoice_payments_widget_local_currency"
                    />
                    <field
                        name="amount_residual_local_currency"
                        class="oe_subtotal_footer_separator"
                        invisible="state == 'draft'"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <record id="account_invoice_list_dual_currency" model="ir.ui.view">
        <field name="name">account.invoice.list.dual.currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="after">
                <field name="secondary_currency_id" column_invisible="True"/>
                <field
                    name="amount_total_secondary_currency"
                    string="Reference Total"
                    sum="Total Reference Amount"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>

    <record id="account_move_list_dual_currency" model="ir.ui.view">
        <field name="name">account.move.list.dual.currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_signed']" position="after">
                <field name="secondary_currency_id" column_invisible="True"/>
                <field
                    name="amount_total_signed_secondary_currency"
                    string="Reference Total"
                    sum="Total Reference Amount"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>
</odoo>
