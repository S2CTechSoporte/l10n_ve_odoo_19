<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_form_dual_currency" model="ir.ui.view">
        <field name="name">account.payment.form.dual.currency</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='date']" position="after">
                <field name="currency_equal" invisible="1"/>
                <field name="conversion_rate_display_currency_id" invisible="1"/>
                <field name="conversion_rate_display_is_usd" invisible="1"/>
                <field name="conversion_rate_display" readonly="1" widget="monetary"
                    invisible="not conversion_rate_display_is_usd"
                    options="{'currency_field': 'conversion_rate_display_currency_id'}"/>
                <field name="conversion_rate_display" string="Reference Rate" readonly="1" widget="monetary"
                    invisible="conversion_rate_display_is_usd"
                    options="{'currency_field': 'conversion_rate_display_currency_id'}"/>
                <!-- Manual rate: visible to accounting administrators on vendor payments only. -->
                <field name="manual_rate_available" invisible="1"/>
                <field name="manual_rate_is_usd" invisible="1"/>
                <field name="manual_rate"
                    groups="account.group_account_manager"
                    invisible="not manual_rate_available or partner_type != 'supplier'"
                    readonly="state != 'draft'"/>
                <label for="manual_conversion_rate" string="Manual USD Rate"
                    groups="account.group_account_manager"
                    invisible="not manual_rate or not manual_rate_available or not manual_rate_is_usd or partner_type != 'supplier'"/>
                <label for="manual_conversion_rate" string="Manual Reference Rate"
                    groups="account.group_account_manager"
                    invisible="not manual_rate or not manual_rate_available or manual_rate_is_usd or partner_type != 'supplier'"/>
                <div class="o_row" name="manual_conversion_rate_div"
                    groups="account.group_account_manager"
                    invisible="not manual_rate or not manual_rate_available or partner_type != 'supplier'">
                    <field name="manual_conversion_rate" digits="[12, 6]"
                        required="manual_rate"
                        readonly="state != 'draft'"/>
                    <field name="manual_rate_currency_id" readonly="1" options="{'no_open': True}"/>
                </div>
                <field name="amount_local" readonly="1"/>
                <field name="amount_ref" readonly="1"/>
                <field name="secondary_currency_id" readonly="1"/>
                <field name="company_currency_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
