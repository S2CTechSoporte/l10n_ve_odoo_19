<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_form_dual_currency" model="ir.ui.view">
        <field name="name">account.payment.form.dual.currency</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='date']" position="after">
                <field name="currency_equal" invisible="1"/>
                <field name="conversion_rate_display_currency_id" invisible="1"/>
                <field name="conversion_rate_display_is_usd" invisible="1"/>
                <field name="conversion_rate_display" readonly="1" widget="monetary"
                    invisible="not conversion_rate_display_is_usd"
                    options="{'currency_field': 'conversion_rate_display_currency_id'}"/>
                <field name="conversion_rate_display" string="Reference Rate" readonly="1" widget="monetary"
                    invisible="conversion_rate_display_is_usd"
                    options="{'currency_field': 'conversion_rate_display_currency_id'}"/>
                <field name="amount_local" readonly="1"/>
                <field name="amount_ref" readonly="1"/>
                <field name="secondary_currency_id" readonly="1"/>
                <field name="company_currency_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
