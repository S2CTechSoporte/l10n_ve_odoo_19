<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="accounting_dual_currency.DualCurrencyFilter">
        <div
            id="filter_dual_currency"
            t-if="controller.cachedFilterOptions.dual_currencies &amp;&amp; controller.cachedFilterOptions.dual_currencies.length > 1"
        >
            <t
                t-set="selected_currency"
                t-value="controller.cachedFilterOptions.dual_currencies.find((currency) => currency.currency_selected)"
            />
            <Dropdown>
                <button class="btn btn-secondary">
                    <i class="fa fa-money me-1"/>
                    <t t-out="selected_currency ? selected_currency.currency_name : 'Currency'"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem
                        t-foreach="controller.cachedFilterOptions.dual_currencies"
                        t-as="currency"
                        t-key="currency.currency_id"
                        class="{ 'selected': currency.currency_selected }"
                        onSelected="() => this.selectDualCurrency(currency.currency_id)"
                    >
                        <t t-out="currency.currency_name"/>
                    </DropdownItem>
                </t>
            </Dropdown>
        </div>
    </t>

    <t
        t-name="accounting_dual_currency.AgedPartnerBalanceFilters"
        t-inherit="account_reports.AgedPartnerBalanceFilters"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[@id='filter_aging_interval']" position="before">
            <t t-call="accounting_dual_currency.DualCurrencyFilter"/>
        </xpath>
    </t>

    <t
        t-name="accounting_dual_currency.AccountReportFilters"
        t-inherit="account_reports.AccountReportFiltersCustomizable"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[@id='filter_rounding_unit']" position="before">
            <t t-if="controller.cachedFilterOptions.dual_currency_general_filter">
                <t t-call="accounting_dual_currency.DualCurrencyFilter"/>
            </t>
        </xpath>
    </t>
</templates>
