<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="accounting_dual_currency.SecondaryCurrencyMenu">
        <div t-if="state.data" class="o_secondary_currency_menu">
            <DropdownGroup group="'web-navbar-group'">
                <Dropdown position="'bottom-end'" beforeOpen.bind="loadRate">
                    <button title="Reference Currency" t-att-disabled="state.updating">
                        <i class="fa fa-money me-1 o_secondary_currency_menu_icon" role="img" aria-label="Reference Currency"/>
                        <strong t-esc="state.data.currency_name"/>
                        <span>: <t t-esc="state.data.formatted_amount"/></span>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem tag="'button'" onSelected.bind="updateRates"
                            attrs="{ disabled: state.updating || !state.data.can_update }">
                            <i class="fa fa-fw fa-refresh me-1 o_secondary_currency_menu_icon" aria-hidden="true"/>
                            <span>Update Now</span>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </DropdownGroup>
        </div>
    </t>
</templates>
